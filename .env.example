# -----------------------------------------------------------------------------
# Repo Rivals - Variables de Entorno de Ejemplo
# -----------------------------------------------------------------------------
# Copia este archivo a .env o .env.local y completa con tus credenciales reales:
# cp .env.example .env.local
# -----------------------------------------------------------------------------

# Supabase Config
# Obtén estos valores en tu panel de Supabase: Project Settings -> API
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu_supabase_service_role_key_aqui

# GitHub Config
# Token de Acceso Personal (PAT) de GitHub con scopes: read:user, repo
# Necesario para consultar GitHub GraphQL API v4 de commits, pull requests e issues
GITHUB_PAT=ghp_tu_github_personal_access_token_aqui

# App Config
# URL base de la aplicación para redirecciones de autenticación OAuth
APP_URL=http://localhost:3000

# Puerto del servidor (opcional, por defecto 3000)
PORT=3000
